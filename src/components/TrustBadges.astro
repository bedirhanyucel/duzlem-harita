---
import Icon from './Icon.astro';

const badges = [
	{ icon: 'badge', title: '4 Yıllık Deneyim', desc: 'Bölgede birikmiş saha ve proje tecrübesi.' },
	{ icon: 'target', title: 'Hassas Ölçüm Yaklaşımı', desc: 'Güncel ekipman ve kontrollü ölçüm süreci.' },
	{ icon: 'network', title: 'Disiplinler Arası Çözüm Ağı', desc: 'Mimari ve hukuki ortaklarla koordineli çalışma.' },
	{ icon: 'shield', title: 'Kontrollü ve Şeffaf Süreç', desc: 'Her aşamada net bilgilendirme ve takip.' },
];
---

<section class="trust">
	<div class="container trust__grid">
		{
			badges.map((b) => (
				<div class="trust__item">
					<span class="trust__icon">
						<Icon name={b.icon} />
					</span>
					<h3>{b.title}</h3>
					<p>{b.desc}</p>
				</div>
			))
		}
	</div>
</section>

<style>
	.trust {
		padding-block: clamp(2.5rem, 5vw, 3.5rem);
		background: var(--bg-surface);
		border-bottom: 1px solid var(--color-border);
	}

	.trust__grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 2rem;
	}

	.trust__item {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.trust__icon {
		width: 44px;
		height: 44px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: var(--radius-sm);
		background: var(--color-warm-white);
		color: var(--color-primary);
		margin-bottom: 0.25rem;
	}

	.trust__icon :global(svg) {
		width: 22px;
		height: 22px;
	}

	.trust__item h3 {
		font-size: 1rem;
	}

	.trust__item p {
		font-size: 0.9rem;
		color: var(--text-body);
		line-height: 1.55;
	}

	@media (max-width: 900px) {
		.trust__grid {
			grid-template-columns: repeat(2, 1fr);
			row-gap: 2.25rem;
		}
	}

	@media (max-width: 480px) {
		.trust__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
