---
import Icon from './Icon.astro';

const reasons = [
	{ title: 'İhtiyaca Uygun Teknik Yaklaşım', desc: 'Her proje kendi ölçeğine ve zeminine göre değerlendirilir.' },
	{ title: 'Saha ve Ofis Sürecinde Kontrol', desc: 'Ölçümden teslim edilen dosyaya kadar süreç takip edilir.' },
	{ title: 'Mimari ve Hukuki Çözüm Ortaklarıyla Koordinasyon', desc: 'Gerekli projelerde disiplinler arası uzmanlık devreye alınır.' },
	{ title: 'Açık İletişim', desc: 'Süreç ve zaman planı hakkında net bilgilendirme yapılır.' },
	{ title: 'Kullanılabilir ve Anlaşılır Teslimler', desc: 'Çıktılar, ilgili kurum ve projelerde doğrudan kullanılabilir formatta hazırlanır.' },
];
---

<section class="whyus" id="kurumsal">
	<div class="container whyus__layout">
		<div class="whyus__intro">
			<p class="eyebrow">Kurumsal</p>
			<h2>Neden DüzlemSa Harita?</h2>
			<p class="section-desc">
				DüzlemSa Harita, yalnızca saha ölçümü yapan bir ofis değil; mimari ve hukuki çözüm
				ortaklarıyla birlikte hareket eden entegre bir proje yapısı sunar.
			</p>
		</div>

		<ul class="whyus__list">
			{
				reasons.map((r) => (
					<li>
						<Icon name="check-circle" class="whyus__icon" />
						<div>
							<h3>{r.title}</h3>
							<p>{r.desc}</p>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.whyus {
		padding-block: var(--section-padding-y);
	}

	.whyus__layout {
		display: grid;
		grid-template-columns: 0.85fr 1.15fr;
		gap: 3rem;
		align-items: start;
	}

	.whyus__intro {
		position: sticky;
		top: 100px;
	}

	.whyus__list {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}

	.whyus__list li {
		display: flex;
		gap: 1rem;
		padding-bottom: 1.75rem;
		border-bottom: 1px solid var(--color-border);
	}

	.whyus__list li:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	.whyus__list :global(.whyus__icon) {
		width: 24px;
		height: 24px;
		flex-shrink: 0;
		color: var(--color-primary);
		margin-top: 0.15rem;
	}

	.whyus__list h3 {
		font-size: 1.05rem;
		margin-bottom: 0.4rem;
	}

	.whyus__list p {
		font-size: 0.92rem;
		color: var(--text-body);
		line-height: 1.6;
	}

	@media (max-width: 900px) {
		.whyus__layout {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.whyus__intro {
			position: static;
		}
	}
</style>
