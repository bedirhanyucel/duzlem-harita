---
import logo from '../assets/logo.png';

const navItems = [
	{ label: 'Ana Sayfa', href: '/' },
	{ label: 'Hizmetler', href: '/hizmetler' },
	{ label: 'Projeler', href: '/#projeler' },
	{ label: 'Kurumsal', href: '/#kurumsal' },
	{ label: 'Teknoloji', href: '/#teknoloji' },
	{ label: 'SSS', href: '/#sss' },
	{ label: 'İletişim', href: '/#iletisim' },
];
---

<header class="site-header">
	<div class="container site-header__bar">
		<a href="/" class="brand" aria-label="DüzlemSa Harita anasayfa">
			<img src={logo.src} width="168" height="98" alt="DüzlemSa Harita" class="brand__mark" />
		</a>

		<nav class="nav" aria-label="Ana menü">
			<ul class="nav__list">
				{
					navItems.map((item) => (
						<li>
							<a href={item.href}>{item.label}</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="site-header__actions">
			<a href="/#iletisim" class="btn btn-primary">Teklif Al</a>
		</div>

		<input type="checkbox" id="menu-toggle" class="menu-toggle-input" aria-hidden="true" />
		<label for="menu-toggle" class="menu-toggle" aria-label="Menüyü aç veya kapat">
			<span></span>
			<span></span>
			<span></span>
		</label>

		<nav class="mobile-nav" aria-label="Mobil menü">
			<ul>
				{
					navItems.map((item) => (
						<li>
							<a href={item.href}>{item.label}</a>
						</li>
					))
				}
				<li><a href="/#iletisim" class="btn btn-primary mobile-nav__cta">Teklif Al</a></li>
			</ul>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(246, 243, 238, 0.92);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--color-border);
	}

	.site-header__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		height: 88px;
		position: relative;
	}

	.brand {
		display: flex;
		align-items: center;
		text-decoration: none;
		flex-shrink: 0;
		height: 100%;
	}

	.brand__mark {
		height: 62px;
		width: auto;
		object-fit: contain;
	}

	.nav {
		flex: 1;
		display: flex;
		justify-content: center;
	}

	.nav__list {
		display: flex;
		align-items: center;
		gap: 1.9rem;
	}

	.nav__list a {
		font-size: 0.93rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--color-charcoal);
		position: relative;
		padding-block: 0.35rem;
	}

	.nav__list a:hover {
		color: var(--color-primary);
	}

	.site-header__actions {
		flex-shrink: 0;
	}

	.menu-toggle-input {
		display: none;
	}

	.menu-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 40px;
		height: 40px;
		cursor: pointer;
		flex-shrink: 0;
	}

	.menu-toggle span {
		display: block;
		height: 2px;
		width: 100%;
		background: var(--color-charcoal);
		transition: transform 0.2s ease, opacity 0.2s ease;
	}

	.mobile-nav {
		display: none;
	}

	@media (max-width: 900px) {
		.nav,
		.site-header__actions {
			display: none;
		}

		.menu-toggle {
			display: flex;
		}

		.mobile-nav {
			display: block;
			position: absolute;
			top: 88px;
			left: 0;
			right: 0;
			background: var(--color-warm-white);
			border-bottom: 1px solid var(--color-border);
			box-shadow: var(--shadow-md);
			max-height: 0;
			overflow: hidden;
			transition: max-height 0.25s ease;
		}

		.mobile-nav ul {
			display: flex;
			flex-direction: column;
			padding: 0.5rem 1.5rem 1.5rem;
			gap: 0.25rem;
		}

		.mobile-nav a {
			display: block;
			padding: 0.75rem 0;
			text-decoration: none;
			font-weight: 600;
			color: var(--color-charcoal);
			border-bottom: 1px solid var(--color-border);
		}

		.mobile-nav__cta {
			border-bottom: none !important;
			text-align: center;
			margin-top: 0.75rem;
		}

		.menu-toggle-input:checked ~ .mobile-nav {
			max-height: 600px;
		}

		.menu-toggle-input:checked ~ .menu-toggle span:nth-child(1) {
			transform: translateY(7px) rotate(45deg);
		}

		.menu-toggle-input:checked ~ .menu-toggle span:nth-child(2) {
			opacity: 0;
		}

		.menu-toggle-input:checked ~ .menu-toggle span:nth-child(3) {
			transform: translateY(-7px) rotate(-45deg);
		}
	}
</style>
