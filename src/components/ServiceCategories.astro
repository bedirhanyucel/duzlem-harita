---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { serviceCategories } from '../data/serviceCategories';

const allServices = await getCollection('services');
---

<section class="categories section--alt" id="hizmetler">
	<div class="container">
		<div class="section-head section-head--center">
			<p class="eyebrow" style="justify-content:center">Hizmetler</p>
			<h2>Tüm hizmet alanlarımız</h2>
			<p class="section-desc">
				Uygun proje kapsamına göre aşağıdaki alanların tamamında veya bir bölümünde teknik
				destek sağlıyoruz.
			</p>
		</div>

		<div class="categories__grid">
			{
				serviceCategories.map((cat) => {
					const items = allServices
						.filter((s) => s.data.category === cat.id)
						.sort((a, b) => a.data.order - b.data.order);

					return (
						<a href={`/hizmetler#${cat.id}`} class="category-card">
							<div class="category-card__head">
								<span class="category-card__icon">
									<Icon name={cat.icon} />
								</span>
								<h3>{cat.title}</h3>
							</div>
							<ul>
								{items.slice(0, 6).map((s) => (
									<li>{s.data.shortTitle}</li>
								))}
							</ul>
							<span class="category-card__link">
								Hizmetleri Gör <Icon name="arrow-right" class="icon-xs" />
							</span>
						</a>
					);
				})
			}
		</div>
	</div>
</section>

<style>
	.categories__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}

	.category-card {
		display: flex;
		flex-direction: column;
		background: var(--bg-page);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: 1.6rem;
		text-decoration: none;
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}

	.category-card:hover {
		border-color: var(--color-primary);
		box-shadow: var(--shadow-sm);
	}

	.category-card__head {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1rem;
	}

	.category-card__icon {
		width: 38px;
		height: 38px;
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: var(--radius-sm);
		background: var(--color-white);
		border: 1px solid var(--color-border);
		color: var(--color-primary);
	}

	.category-card__icon :global(svg) {
		width: 19px;
		height: 19px;
	}

	.category-card h3 {
		font-size: 0.98rem;
		line-height: 1.3;
	}

	.category-card ul {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		margin-bottom: 1.1rem;
	}

	.category-card li {
		font-size: 0.86rem;
		color: var(--text-body);
		padding-left: 0.9rem;
		position: relative;
	}

	.category-card li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.55em;
		width: 5px;
		height: 5px;
		background: var(--color-accent-olive);
	}

	.category-card__link {
		margin-top: auto;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.86rem;
		font-weight: 700;
		color: var(--color-primary);
	}

	.category-card__link :global(.icon-xs) {
		width: 14px;
		height: 14px;
	}

	@media (max-width: 900px) {
		.categories__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 560px) {
		.categories__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
