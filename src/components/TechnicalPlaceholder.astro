---
import Icon from './Icon.astro';

interface Props {
	variant?: 'contour' | 'grid' | 'parcel' | 'coordinate';
	icon?: string;
	label?: string;
	class?: string;
	showBadge?: boolean;
}

const {
	variant = 'contour',
	icon,
	label,
	class: className = '',
	showBadge = true,
} = Astro.props;
---

<div class={`tech-placeholder tech-placeholder--${variant} ${className}`}>
	<svg class="tech-placeholder__svg" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
		{
			variant === 'contour' && (
				<>
					<path d="M-20 220 C 80 180, 140 240, 240 200 S 380 160, 420 190" />
					<path d="M-20 170 C 100 140, 160 200, 260 160 S 400 130, 420 150" />
					<path d="M-20 260 C 90 230, 150 280, 250 250 S 390 210, 420 240" />
				</>
			)
		}
		{
			variant === 'grid' && (
				<g class="tech-placeholder__gridlines">
					{Array.from({ length: 11 }).map((_, i) => (
						<line x1={i * 40} y1="0" x2={i * 40} y2="300" />
					))}
					{Array.from({ length: 8 }).map((_, i) => (
						<line x1="0" y1={i * 40} x2="400" y2={i * 40} />
					))}
				</g>
			)
		}
		{
			variant === 'parcel' && (
				<>
					<polygon points="60,220 150,80 260,110 300,230 180,270" class="tech-placeholder__parcel" />
					<circle cx="60" cy="220" r="4" />
					<circle cx="150" cy="80" r="4" />
					<circle cx="260" cy="110" r="4" />
					<circle cx="300" cy="230" r="4" />
					<circle cx="180" cy="270" r="4" />
				</>
			)
		}
		{
			variant === 'coordinate' && (
				<>
					<line x1="40" y1="20" x2="40" y2="280" />
					<line x1="20" y1="250" x2="380" y2="250" />
					<circle cx="180" cy="120" r="5" />
					<circle cx="260" cy="180" r="5" />
					<line x1="180" y1="120" x2="260" y2="180" stroke-dasharray="4 4" />
				</>
			)
		}
	</svg>

	{
		icon && (
			<span class="tech-placeholder__icon">
				<Icon name={icon} />
			</span>
		)
	}

	{
		label && showBadge && (
			<span class="tech-placeholder__badge">{label}</span>
		)
	}
</div>

<style>
	.tech-placeholder {
		position: relative;
		width: 100%;
		height: 100%;
		overflow: hidden;
		background: linear-gradient(150deg, var(--color-charcoal) 0%, #1e2530 100%);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.tech-placeholder__svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.tech-placeholder--contour path {
		fill: none;
		stroke: rgba(142, 31, 45, 0.5);
		stroke-width: 1.5;
	}

	.tech-placeholder--contour path:nth-child(2) {
		stroke: rgba(159, 179, 106, 0.35);
	}

	.tech-placeholder--contour path:nth-child(3) {
		stroke: rgba(246, 243, 238, 0.12);
	}

	.tech-placeholder__gridlines line {
		stroke: rgba(246, 243, 238, 0.08);
		stroke-width: 1;
	}

	.tech-placeholder__parcel {
		fill: rgba(142, 31, 45, 0.18);
		stroke: rgba(142, 31, 45, 0.7);
		stroke-width: 1.5;
	}

	.tech-placeholder--parcel circle {
		fill: var(--color-accent-olive);
	}

	.tech-placeholder--coordinate line {
		stroke: rgba(246, 243, 238, 0.25);
		stroke-width: 1.5;
	}

	.tech-placeholder--coordinate circle {
		fill: var(--color-accent-olive);
	}

	.tech-placeholder__icon {
		position: relative;
		width: 25%;
		max-width: 88px;
		aspect-ratio: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		color: rgba(246, 243, 238, 0.85);
	}

	.tech-placeholder__icon :global(svg) {
		width: 100%;
		height: 100%;
	}

	.tech-placeholder__badge {
		position: absolute;
		bottom: 0.75rem;
		right: 0.75rem;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.03em;
		color: rgba(246, 243, 238, 0.75);
		background: rgba(20, 24, 27, 0.55);
		border: 1px solid rgba(246, 243, 238, 0.2);
		padding: 0.25rem 0.6rem;
		border-radius: 999px;
	}
</style>
