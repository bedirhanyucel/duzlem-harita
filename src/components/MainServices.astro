---
import Icon from './Icon.astro';

const services = [
	{
		icon: 'compass',
		title: 'Parsel Sınır Tespiti ve Aplikasyon',
		desc: 'Arsa ve tarla sınırlarının teknik olarak belirlenmesi, köşe noktalarının tespiti ve aplikasyon işlemlerinin güvenilir şekilde yürütülmesi.',
		items: ['Sınır ve köşe noktası tespiti', 'Yer gösterme', 'Aplikasyon'],
		href: '/hizmetler/parsel-sinir-tespiti-aplikasyon',
	},
	{
		icon: 'building',
		title: 'Plankote, Yapı Aplikasyonu ve Şantiye Ölçümleri',
		desc: 'Mimari ve inşaat projeleri için plankote, temel aplikasyonu, kot kontrolleri ve şantiye ölçümlerinin hassas şekilde gerçekleştirilmesi.',
		items: ['Temel ve aks aplikasyonu', 'Kot kontrolleri', 'As-built ölçümleri'],
		href: '/hizmetler/yapi-aplikasyonu-santiye-olcumleri',
	},
	{
		icon: 'layers',
		title: 'İfraz, Tevhit ve İmar Uygulamaları',
		desc: 'Parsel düzenleme, ifraz, tevhit, yola terk ve teknik imar süreçlerinin proje ihtiyaçlarına uygun şekilde yönetilmesi.',
		items: ['İfraz ve tevhit', 'Yola terk / yoldan ihdas', 'İmar uygulamaları'],
		href: '/hizmetler/ifraz-tevhit',
	},
];
---

<section class="services" id="one-cikan">
	<div class="container">
		<div class="section-head section-head--center">
			<p class="eyebrow" style="justify-content:center">Öne Çıkan Hizmetler</p>
			<h2>En çok tercih edilen üç hizmet alanımız</h2>
		</div>

		<div class="services__grid">
			{
				services.map((s) => (
					<article class="service-card">
						<span class="service-card__icon">
							<Icon name={s.icon} />
						</span>
						<h3>{s.title}</h3>
						<p>{s.desc}</p>
						<ul>
							{s.items.map((item) => (
								<li>
									<Icon name="check" class="icon-xs" />
									{item}
								</li>
							))}
						</ul>
						<a href={s.href} class="service-card__link">
							Detaylı Bilgi <Icon name="arrow-right" class="icon-xs" />
						</a>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.services {
		padding-block: var(--section-padding-y);
	}

	.services__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.75rem;
	}

	.service-card {
		background: var(--bg-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: 2rem;
		display: flex;
		flex-direction: column;
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}

	.service-card:hover {
		border-color: var(--color-primary);
		box-shadow: var(--shadow-md);
	}

	.service-card__icon {
		width: 52px;
		height: 52px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: var(--radius-md);
		background: var(--color-primary);
		color: var(--color-warm-white);
		margin-bottom: 1.25rem;
	}

	.service-card__icon :global(svg) {
		width: 26px;
		height: 26px;
	}

	.service-card h3 {
		margin-bottom: 0.75rem;
	}

	.service-card p {
		font-size: 0.94rem;
		color: var(--text-body);
		line-height: 1.65;
		margin-bottom: 1.25rem;
	}

	.service-card ul {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		margin-bottom: 1.5rem;
	}

	.service-card li {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.88rem;
		color: var(--text-heading);
	}

	.service-card li :global(.icon-xs) {
		width: 15px;
		height: 15px;
		color: var(--color-accent-olive);
		flex-shrink: 0;
	}

	.service-card__link {
		margin-top: auto;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--color-primary);
		text-decoration: none;
	}

	.service-card__link :global(.icon-xs) {
		width: 15px;
		height: 15px;
	}

	@media (max-width: 900px) {
		.services__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
