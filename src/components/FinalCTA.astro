---
import Icon from './Icon.astro';
import { company } from '../data/company';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Projenizin teknik kapsamını birlikte değerlendirelim.',
	description = 'Parsel, imar veya şantiye sürecinizle ilgili ihtiyacınızı iletin; size en uygun teknik yaklaşımı birlikte belirleyelim.',
} = Astro.props;
---

<section class="cta bg-grid-dark" id="iletisim">
	<div class="container cta__inner">
		<h2>{title}</h2>
		<p>{description}</p>

		<div class="cta__actions">
			<a href="/teklif-al" class="btn btn-primary">
				<Icon name="mail" class="icon-xs" />
				Teklif Al
			</a>
			<a href={company.contact.phoneUri} class="btn btn-outline-light">
				<Icon name="phone" class="icon-xs" />
				Hemen Ara
			</a>
			<a href={company.contact.whatsappUriWithMessage} target="_blank" rel="noopener" class="btn btn-outline-light">
				<Icon name="chat" class="icon-xs" />
				WhatsApp
			</a>
		</div>

		<div class="cta__details">
			<div>
				<Icon name="mappin" class="icon-xs" />
				<span>{company.address.full}</span>
			</div>
			<div>
				<Icon name="phone" class="icon-xs" />
				<span>{company.contact.phoneDisplay}</span>
			</div>
			<div>
				<Icon name="mail" class="icon-xs" />
				<span>{company.contact.email}</span>
			</div>
		</div>
	</div>
</section>

<style>
	.cta {
		background: var(--color-charcoal);
		color: var(--color-warm-white);
		padding-block: var(--section-padding-y);
		text-align: center;
	}

	.cta__inner {
		max-width: 720px;
		margin-inline: auto;
	}

	.cta h2 {
		color: var(--color-warm-white);
	}

	.cta p {
		margin-top: 1rem;
		font-size: 1.05rem;
		color: rgba(246, 243, 238, 0.75);
		line-height: 1.7;
	}

	.cta__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
		margin-top: 2.25rem;
	}

	.cta__actions :global(.icon-xs) {
		width: 16px;
		height: 16px;
	}

	.cta__details {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1.75rem;
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid rgba(246, 243, 238, 0.15);
	}

	.cta__details div {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.85rem;
		color: rgba(246, 243, 238, 0.65);
		max-width: 320px;
		text-align: left;
	}

	.cta__details :global(.icon-xs) {
		width: 16px;
		height: 16px;
		flex-shrink: 0;
		color: var(--color-accent-olive);
	}

	@media (max-width: 640px) {
		.cta__actions .btn {
			width: 100%;
		}
	}
</style>
