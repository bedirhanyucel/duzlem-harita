---
import FAQList from './FAQList.astro';

const faqs = [
	{
		q: 'Parsel sınır tespiti nasıl yapılır?',
		a: 'Tapu ve kadastro kayıtları incelenerek, saha üzerinde GNSS/RTK veya total station ile ölçüm yapılır; sınır ve köşe noktaları teknik olarak belirlenip aplikasyonu gerçekleştirilir.',
	},
	{
		q: 'Plankote hangi durumlarda gerekir?',
		a: 'Yapı projelendirme, zemin kotu belirleme ve şantiye planlaması öncesinde arazinin mevcut durumunu gösteren plankote çalışması gerekir.',
	},
	{
		q: 'İfraz ve tevhit işlemleri nedir?',
		a: 'İfraz, bir parselin birden fazla parçaya ayrılması; tevhit ise birden fazla parselin tek parselde birleştirilmesi işlemidir. Her ikisi de imar mevzuatına uygun teknik dosya ile yürütülür.',
	},
	{
		q: 'Teklif almak için hangi bilgiler gereklidir?',
		a: 'Parsel/ada bilgisi veya konum, proje türü ve varsa mevcut proje/imar bilgileri ile iletişime geçmeniz yeterlidir. Kapsamı birlikte netleştiririz.',
	},
];
---

<section class="faq section--alt" id="sss">
	<div class="container faq__layout">
		<div class="section-head">
			<p class="eyebrow">SSS</p>
			<h2>Sıkça sorulan sorular</h2>
		</div>

		<FAQList items={faqs} />
	</div>
</section>

<style>
	.faq__layout {
		display: grid;
		grid-template-columns: 0.8fr 1.2fr;
		gap: 3rem;
	}

	@media (max-width: 900px) {
		.faq__layout {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
	}
</style>
